# Android / Gradle
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/*.iml
android/captures/
android/.cxx/
# Wrapper jar (~43 KB) IS committed on purpose — it lets any teammate
# clone-and-build with `./gradlew` immediately, no Android Studio sync
# required first. Do not add it here.

# Python / ml
ml/.venv/
ml/__pycache__/
**/__pycache__/
*.pyc
.ipynb_checkpoints/

# Datasets — kept out of git regardless (IO-VNBD is large and has its
# own redistribution terms; see data/README.md for the re-download path).
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Model artifacts: general rule is still "don't commit exported binaries
# blindly" (future/larger models, alternate versions, etc.), but
# velocity_v1.onnx (~21MB, well under GitHub's 100MB limit) is committed
# on purpose as of 2026-08-26 — a teammate cloning this repo cannot
# regenerate it themselves anyway (the IO-VNBD dataset above isn't
# shareable via git), so keeping the one artifact that already exists out
# of version control only adds friction with no real benefit. See
# docs/PROJECT_MAP.md for the full reasoning.
models/*.onnx
!models/velocity_v1.onnx
!models/reacquisition_drift_v1.onnx
models/*.tflite
android/app/src/main/assets/*.onnx
!android/app/src/main/assets/velocity_v1.onnx
!android/app/src/main/assets/reacquisition_drift_v1.onnx

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/
